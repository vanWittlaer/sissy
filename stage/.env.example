# Compose-level env for the STAGE stack (interpolated INTO compose.yaml).
# Copy to .env and fill in.
# Must match prod/.env exactly — promoting a build is deploying its tag.
APP_IMAGE=ghcr.io/your-org/your-shop
TAG=latest
DOMAIN=stage.example.com
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Optional — defaults to the tag baked into compose.yaml. Kept commented so
# bootstrap.sh doesn't demand it on every host; uncomment to rehearse a DB
# upgrade here before prod takes it. See the database service in compose.yaml.
#MARIADB_VERSION=11.8
# Optional — storefront session idle timeout in seconds (default 86400, 1 day).
# Sessions persist across deploys in data/sessions; this is when PHP's GC
# deletes an idle one. Going above 1 day buys nothing: Shopware's own
# context token (shopware.api.store.context_lifetime) expires after P1D.
#SESSION_LIFETIME=86400
# Generate with: htpasswd -nb user pass
# THEN double every '$' to '$$' before pasting here.
BASIC_AUTH=user:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx.
