# Compose-level env for the STAGE stack (interpolated INTO compose.yaml).
# Copy to .env and fill in.
TAG=latest
DOMAIN=stage.example.com
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Generate with: htpasswd -nb user pass
# THEN double every '$' to '$$' before pasting here.
BASIC_AUTH=user:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx.
