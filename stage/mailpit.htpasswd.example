# Basic-auth for the Mailpit UI at https://mailpit.<DOMAIN> (stage/compose.yaml
# mounts this as MP_UI_AUTH_FILE). Independent of the storefront's BASIC_AUTH.
# Generate with:  htpasswd -nbB user pass > stage/mailpit.htpasswd
# Keep the '$' single — this file is NOT interpolated by compose.
user:$2y$05$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
