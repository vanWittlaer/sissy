# Compose-level env for the PROD stack (interpolated INTO compose.yaml).
# Copy to .env and fill in. These are NOT Shopware's runtime vars (see .env.local).
TAG=latest
# DOMAIN is canonical (what Shopware serves); DOMAIN_REDIRECT 301s to it.
DOMAIN=www.example.com
DOMAIN_REDIRECT=example.com
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
