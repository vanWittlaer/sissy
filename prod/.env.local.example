# Shopware runtime env for PROD, injected as container env vars via env_file.
# Copy to .env.local. Values are LITERAL — ${...} is NOT expanded here,
# so DATABASE_URL / LOCK_DSN must contain the password spelled out.
APP_ENV=prod
APP_URL=https://www.example.com
APP_SECRET=REPLACE_WITH_STABLE_SECRET
INSTANCE_ID=REPLACE_WITH_STABLE_INSTANCE_ID
DATABASE_URL=mysql://shopware:change-me@database:3306/shopware
# NOT flock: with separate worker/scheduler containers a filesystem lock
# no longer coordinates. Point Symfony lock at the shared DB.
LOCK_DSN=mysql://shopware:change-me@database:3306/shopware
# Symfony's own var (not TRUSTED_PROXIES). Safe only because no app port is published.
# Without this, asset URLs come out http:// on an https page (mixed content).
SYMFONY_TRUSTED_PROXIES=0.0.0.0/0
# Skip re-rendering mail variables on every send (prod only).
SHOPWARE_UPDATE_MAIL_VARIABLES=0
BLUE_GREEN_DEPLOYMENT=0
SHOPWARE_ES_ENABLED=0
MAILER_DSN=smtp://user:pass@smtp-host:587
# Deliberately ABSENT (drop Redis / RabbitMQ / OpenSearch):
#   REDIS_DSN               -> filesystem cache + native sessions
#   MESSENGER_TRANSPORT_DSN -> falls back to doctrine:// (MariaDB is the queue)
#   OPENSEARCH_URL
